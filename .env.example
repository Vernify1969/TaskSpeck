# Leave both lines empty to keep the no-login demo.
# GitHub Pages does this. The app opens as Maya and saves on that phone.
#
# Fill both lines in to turn on real accounts and the shared database.
# Use the anon public key from Supabase. Never put the service_role secret here.
# Do not commit a filled-in .env file.

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
