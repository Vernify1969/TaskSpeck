{
  "name": "taskspeck",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "demo": "node scripts/run-demo.mjs",
    "build": "vite build",
    "build:pages": "TASKSPECK_PAGES=1 VITE_LOCAL_API=1 vite build",
    "preview": "vite preview",
    "preview:pages": "TASKSPECK_PAGES=1 vite preview --host 127.0.0.1 --port 5199 --strictPort",
    "test": "node --test --test-concurrency=1 shared/chatGuard.test.js server/api.test.js server/pagesDemo.test.js",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "leaflet": "^1.9.4"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "vite": "^6.0.0"
  }
}
